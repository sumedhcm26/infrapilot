# InfraPilot Backend Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Application
APP_NAME=InfraPilot
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Database
# SQLite (default for local dev - no setup needed!)
DATABASE_URL=sqlite+aiosqlite:///./infrapilot.db

# PostgreSQL (for production or Docker Compose)
# DATABASE_URL=postgresql+asyncpg://infrapilot:password@localhost:5432/infrapilot

# Security - CHANGE THIS in production!
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-in-production

# CORS - Frontend URL(s) allowed to call this API
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Health Check
HEALTH_CHECK_INTERVAL=60
HEALTH_CHECK_TIMEOUT=10
