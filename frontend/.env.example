# InfraPilot Frontend Environment Variables
# Copy to .env.local for local overrides:
#   cp .env.example .env.local
#
# Vite exposes env vars prefixed with VITE_ to the browser.
# Never put secrets here - they are visible in the browser!

# Backend API URL
# Local development (Vite proxy handles /api, but direct URL works too):
VITE_API_URL=http://localhost:8000

# Production (replace with your Render backend URL):
# VITE_API_URL=https://infrapilot-backend.onrender.com
