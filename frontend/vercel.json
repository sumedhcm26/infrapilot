{
  "version": 2,
  "comment": "InfraPilot Frontend - Vercel Deployment Config",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html",
      "comment": "SPA routing - all paths serve index.html"
    }
  ],
  "env": {
    "VITE_API_URL": "https://infrapilot-backend.onrender.com"
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
